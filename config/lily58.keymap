#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        Paste_Unformat_Combo: Paste_Unformat_Combo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_GUI &kp LEFT_ALT &kp LEFT_SHIFT &kp V>;
            label = "PASTE_UNFORMAT_COMBO";
        };

        emoji_call: emoji_call {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_GUI &kp LEFT_CONTROL &kp SPACE>;
            label = "EMOJI_CALL";
        };
    };

    behaviors {
        paste_unformat_behave: paste_unformat_behave {
            compatible = "zmk,behavior-tap-dance";
            label = "PASTE_UNFORMAT_BEHAVE";
            #binding-cells = <0>;
            bindings = <&kp LEFT_ALT>, <&kp LEFT_ALT>, <&Paste_Unformat_Combo>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  n/a   |  |  n/a  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | GUI  | LOWER| SPACE|  n/a   |  |  n/a  | ENTER| RAISE | BSPC  |
            // Note: Silakka54 has 54 keys - the 4 positions marked n/a are not present (inner thumb + encoder positions)

            display-name = "Base";
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3  &kp N4                  &kp N5                        &kp N6         &kp N7         &kp N8     &kp N9   &kp N0         &kp RIGHT_CONTROL
&kp TAB    &kp Q   &kp W   &kp F   &kp P                   &kp G                         &kp J          &kp L          &kp U      &kp Y    &kp SEMICOLON  &kp NON_US_BACKSLASH
&kp SPACE  &kp A   &kp S   &kp R   &kp T                   &kp D                         &kp H          &kp N          &kp E      &kp I    &kp O          &kp SQT
&kp LSHFT  &kp Z   &kp X   &kp C   &kp V                   &kp B         &none    &none  &kp N          &kp M          &kp COMMA  &kp DOT  &kp FSLH       &kp ENTER
                           &mo 1   &paste_unformat_behave  &kp LEFT_GUI  &none    &none  &kp RIGHT_GUI  &kp RIGHT_ALT  &mo 2
            >;
        };

        f1_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   | USB  | BLE   |       |      |       |BTCLRALL|
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |  n/a   |  |  n/a  |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |  n/a   |  |  n/a  |      |       |       |

            display-name = "F1 Layer";
            bindings = <
&kp ENTER    &kp F1          &kp F2          &kp F3           &kp F4  &kp F5                       &kp F6           &kp F7           &kp F8           &kp F9           &kp F10  &trans
&kp MINUS    &kp EQUAL       &kp UP_ARROW    &trans           &trans  &trans                       &trans           &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &trans   &trans
&emoji_call  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &bootloader                  &trans           &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &trans   &trans
&trans       &trans          &trans          &trans           &trans  &trans       &none    &none  &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans   &trans
                                             &trans           &trans  &trans       &none    &none  &trans           &trans           &trans
            >;
        };

        f2_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |  n/a   |  |  n/a  |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |  n/a   |  |  n/a  |      |       |       |

            display-name = "F2 Layer";
            bindings = <
&trans  &trans          &trans          &trans           &trans  &trans                  &kp KP_MINUS  &kp KP_PLUS       &trans             &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans
&trans  &mkp MB2        &mmv MOVE_UP    &mkp MB1         &trans  &trans                  &trans        &trans            &trans             &trans            &kp MINUS          &kp EQUAL
&trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans  &trans                  &bootloader   &kp K_PLAY_PAUSE  &kp K_PREV         &kp K_NEXT        &trans             &trans
&trans  &trans          &trans          &trans           &trans  &trans  &none    &none  &kp KP_PLUS   &kp K_MUTE        &kp K_VOLUME_DOWN  &kp K_VOL_UP      &kp DELETE         &trans
                                        &trans           &trans  &trans  &none    &none  &trans        &trans            &trans
            >;
        };

        f3_layer {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &out OUT_USB  &trans  &kp C_BRI_DN  &kp C_BRI_UP  &trans  &bt BT_CLR_ALL
&trans      &trans        &trans        &trans        &trans        &trans                        &out OUT_BLE  &trans  &trans        &trans        &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans                        &trans        &trans  &trans        &trans        &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans        &none    &none  &trans        &trans  &kp K_PREV    &kp K_NEXT    &trans  &trans
                                        &trans        &trans        &trans        &none    &none  &trans        &trans  &trans
            >;

            label = "F3 Layer";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        f1+f2 {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
